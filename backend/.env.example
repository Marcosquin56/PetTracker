DATABASE_URL="postgresql://pettracker:pettracker@localhost:5432/pettracker?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Credenciales del MinIO de docker-compose.yml (S3-compatible).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pettracker-photos"
S3_ACCESS_KEY_ID="pettracker"
S3_SECRET_ACCESS_KEY="pettracker123"
S3_PUBLIC_BASE_URL="http://localhost:9000/pettracker-photos"

# Ruta a la service-account JSON de un proyecto Firebase (Console > Project
# Settings > Service Accounts > Generate new private key). Solo se usa para
# enviar push vía FCM — no hay Firestore/Storage/Auth de por medio.
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# URL pública por la que se llega a esta API (el túnel de cloudflared o el
# dominio real en producción). Se usa para armar el link del email de
# "olvidé mi contraseña".
APP_PUBLIC_URL="http://localhost:3000"

# Resend (API HTTP) para el correo de recuperación de contraseña. Se usa la
# API en vez de SMTP porque varios hosts (Render incluido) bloquean el
# tráfico saliente por el puerto SMTP. Sin RESEND_API_KEY, el link se
# imprime en el log del servidor en vez de mandarse (ver MailService).
# Key en resend.com/api-keys. Mientras no verifiques un dominio propio ahí,
# solo podés mandar a la casilla con la que te registraste en Resend.
RESEND_API_KEY=""
MAIL_FROM="PetTracker <no-reply@pettracker.app>"

# API key de servidor para Google Places (veterinarias cercanas, VetsService).
# Habilitar "Places API" en el mismo proyecto de Google Cloud que la key de
# Maps del Android manifest, pero generar una key NUEVA sin restricción de
# paquete/SHA1 (esta corre en el backend, no en el celular) — restringirla
# por API a "Places API" y, si se puede, por IP del servidor.
GOOGLE_PLACES_API_KEY=""

PORT=3000
