DATABASE_URL="postgresql://pettracker:pettracker@localhost:5432/pettracker?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Credenciales del MinIO de docker-compose.yml (S3-compatible).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pettracker-photos"
S3_ACCESS_KEY_ID="pettracker"
S3_SECRET_ACCESS_KEY="pettracker123"
S3_PUBLIC_BASE_URL="http://localhost:9000/pettracker-photos"

# Ruta a la service-account JSON de un proyecto Firebase (Console > Project
# Settings > Service Accounts > Generate new private key). Solo se usa para
# enviar push vía FCM — no hay Firestore/Storage/Auth de por medio.
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# URL pública por la que se llega a esta API (el túnel de cloudflared o el
# dominio real en producción). Se usa para armar el link del email de
# "olvidé mi contraseña".
APP_PUBLIC_URL="http://localhost:3000"

# SMTP para el correo de recuperación de contraseña. Sin SMTP_HOST, el link
# se imprime en el log del servidor en vez de mandarse (ver MailService).
# Con Gmail: smtp.gmail.com, puerto 587, SMTP_USER tu Gmail, SMTP_PASS una
# "contraseña de aplicación" (myaccount.google.com/apppasswords) — la
# contraseña normal de la cuenta no funciona con SMTP.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PetTracker <no-reply@pettracker.app>"

PORT=3000
